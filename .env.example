# ==============================================================================
# Grand Aurelia Resort & Suites — Environment Variables Template
# Copy this file to .env and configure with your MongoDB credentials
# ==============================================================================

# MongoDB Connection URI (Atlas Cloud Cluster or Local Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_DATABASE=grand_aurelia_hotel

# Alternative: Local MongoDB connection
# MONGODB_URI=mongodb://localhost:27017/grand_aurelia_hotel

# Backend Server Settings
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Vite Frontend Variables (Accessible via import.meta.env)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME="Grand Aurelia Resort & Suites"
VITE_MONGODB_DATABASE=grand_aurelia_hotel
VITE_ENABLE_STORAGE_FALLBACK=true
