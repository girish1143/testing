# ==============================================================================
# Grand Aurelia Resort & Suites — Environment Variables Template
# Copy this file to .env and configure with your Supabase credentials
# ==============================================================================

# Supabase Cloud Database & Storage
# Obtain these from your Supabase Dashboard: Settings > API (https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_SUPABASE_PROJECT_ID=grand-aurelia-luxury

# Application Configuration
VITE_APP_NAME="Grand Aurelia Resort & Suites"
VITE_ENABLE_STORAGE_FALLBACK=true
